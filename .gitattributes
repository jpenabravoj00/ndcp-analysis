# Linguist language detection overrides
# Hide generated interactive HTML reports and large data from GitHub language statistics
*.html linguist-vendored
index.html linguist-vendored
ndcp_interactive_report.html linguist-vendored
reports/*.html linguist-vendored

# Ensure Python is detected accurately as primary codebase language
*.py linguist-detectable=true
*.ipynb linguist-detectable=true

# Large data attributes
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
